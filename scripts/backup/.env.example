# Configuration de scripts/backup/backup-prod.sh : copier en scripts/backup/.env (ignoré par git)

# Dossier cible, ex: le partage NAS monté sur le poste
FCU_BACKUP_DIR=/chemin/vers/le/dossier/de/sauvegarde

# Clé publique age (age-keygen : la clé publique va ici, la clé secrète AGE-SECRET-KEY-1… dans un gestionnaire de mots de passe)
FCU_BACKUP_AGE_PUBLIC_KEY=age1...

# Jeton d'API Scalingo (dashboard > Profile > API tokens) : utilisé par la CLI et par l'API (liste et téléchargement de la sauvegarde)
SCALINGO_API_TOKEN=

# Clé API Grist (profil utilisateur sur https://grist.numerique.gouv.fr) : sans elle, les docs Grist sont ignorés
GRIST_API_KEY=

# Optionnel (valeurs par défaut)
# FCU_BACKUP_SCALINGO_APP=france-chaleur-urbaine
# FCU_BACKUP_SCALINGO_REGION=osc-fr1
# FCU_BACKUP_GRIST_ORG=fcu                  # tous les docs de tous les workspaces de l'organisation
# FCU_BACKUP_GRIST_WORKSPACES="Home"        # pour se limiter à certains workspaces (noms séparés par des espaces)
# FCU_BACKUP_GIT_BUNDLE=true
